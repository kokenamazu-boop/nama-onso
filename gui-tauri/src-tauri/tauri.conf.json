{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nama Onso DB Pilot",
  "version": "0.1.0",
  "identifier": "audio.nama.onso.dbpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "音素DB（試作） - Nama Onso",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "音素DB窓の試作（段階1）",
    "longDescription": "nama-onso の音素DB窓を Tauri 2 + React で置き換える試作。検索・試聴・ドラッグ・書き出しを Python サイドカー経由で行います。"
  }
}
